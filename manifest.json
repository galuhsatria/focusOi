{
  "manifest_version": 2,
  "name": "FocusOi",
  "version": "1.0",
  "description": "Lu pakek gue buat jadiin pomodoro biar lu focusoi",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["storage", "notifications", "background"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "FocusOi"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
